<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0 mx-auto">
      <h2>EDIT</h2>

      <% if @userr.errors.any? %>
        <div class ="alert">
        <%= @userr.errors.count %>件のエラーが見つかりました。
        <% @userr.errors.full_messages.each do |message| %>
          <p><%= message %></li>
        <% end %>
        </div>
      <% end %>

        <%= form_with model: @userr, local:true do |f| %>
        <div class ="edit-form">
          <label for="inputName">Name</label>
          <%= f.text_field :name, autfocus: true, id:"inputName", placeholder:"名前"%>
        </div>


        <div class ="edit-form">
          <p>Introduction</p>
          <%= f.text_field :introduction, autfocus: true, id:"introduction", placeholder:"イントロダクション"%>
        </div>

        <div class ="edit-form">
          <p>profile_image</p>
          <%= f.attachment_field :profile_image, placeholder:"プロフィール画像" %>
        </div>

        <div class ="edit-form">
          <%= f.submit "Update User" %>
        </div>

      <% end %>
    </div>
  </div>
</div>