<div class="container px-5 px-sm-0">
  <div class="row">

    <div class="col-md-3">
      <%= render 'books/new', userr: @userr, book: @book %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Book detail</h2>
    <table class="table table-hover table-inverse">
        <tbody>
            <tr>

              <td>
                <%= link_to user_path(@book_detail.user.id) do %>
                  <%= attachment_image_tag @book_detail.user, :profile_image, fallback: "no_image.jpg", size: "100x100" %>
                <% end %>
                <br><%= link_to @book_detail.user.name, user_path(@book_detail.user.id) %>
              </td>
              <td><%= @book_detail.title %></td>
              <td><%= @book_detail.body %></td>


              <% if @book_detail.user_id == current_user.id %>
                <td><p><%= link_to "Edit", edit_book_path(@book_detail), {class: "EDIT-button"} %></p></td>
                <td><p><%= link_to "Destroy", book_path(@book_detail.id), method: :delete, "data-confirm" => "Are you sure?", class: "DELETE-button" %></p></td>
              <% end %>
              </td>

            </tr>
        </tbody>
      </table>
    </div>

  </div>
</div>