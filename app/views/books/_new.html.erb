<% if @book.errors.any? %>
<div class ="alert">
  <%= @book.errors.count %>件のエラーが見つかりました。
    <% @book.errors.full_messages.each do |message| %>
      <p><%= message %></p>
    <% end %>
</div>
<% end %>

<h1>User info</h1>
  <%= attachment_image_tag @userr, :profile_image, fallback: "no_image.jpg", size: "100x100" %>
  <p>name:<%= userr.name %></p>
  <p>introduction:<%= userr.introduction %></p>


      <%= link_to  edit_user_path(@userr) do %>
        <div class= "edit-button-2">
          <i class="fas fa-user-cog"></i>
        </div>
      <% end %>


<h1>New book</h1>
  <%= form_with model: @book, url: books_path, local:true do |f| %>
    <h4>Title</h4>
      <%= f.text_field :title %>
    <h4>Opinion</h4>
      <%= f.text_area :body %>
      <%= f.submit 'Create Book' %>
  <% end %>